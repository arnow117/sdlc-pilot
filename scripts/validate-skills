#!/usr/bin/env bash
# Fast, dependency-free repository checks for the lightweight SDLC.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 2

ROOT="skills"
REF="$ROOT/sdlc/references"
fail=0

err() {
  echo "  ✗ $1"
  fail=$((fail + 1))
}

ok() {
  echo "  ✓ $1"
}

echo "== 1. Lightweight runtime and shared references =="
for path in \
  scripts/lifecycle_state.py \
  scripts/backlog.py \
  scripts/board.py \
  scripts/contrast_check.py \
  scripts/test_lifecycle_state.py \
  scripts/test_backlog.py \
  scripts/test_scenarios.py \
  scripts/test_contrast_check.py \
  scripts/test_hallmark_catalog.py \
  scripts/vibe_test.py \
  scripts/vibe_host.py \
  scripts/test_vibe_test.py \
  scripts/test_vibe_host.py \
  scripts/test_security_dependency.py \
  "$ROOT/sdlc/scripts/check_security_dependency.py" \
  "$REF/role-routing.md" \
  "$REF/lightweight-runtime.md" \
  "$REF/lifecycles/product-design.md" \
  "$REF/lifecycles/software-delivery.md" \
  "$REF/stage-agent-protocol.md" \
  "$REF/runtime-adapters/codex.md" \
  "$REF/runtime-adapters/t3-code.md" \
  "$REF/templates/TASK.md" \
  "$REF/templates/CHECKPOINT.md" \
  "$REF/roles" \
  "$REF/validate-modes" \
  "$REF/languages"; do
  if [ -e "$path" ]; then
    ok "$path"
  else
    err "缺失: $path"
  fi
done

echo "== 2. Skill frontmatter =="
skill_count=0
for file in "$ROOT"/*/SKILL.md; do
  skill_count=$((skill_count + 1))
  first_line=$(head -n 1 "$file")
  [ "$first_line" = "---" ] || err "$file 首行不是 ---"
  head -n 20 "$file" | grep -qE '^name:[[:space:]]*[^[:space:]]' \
    || err "$file 缺少 name"
  head -n 20 "$file" | grep -qE '^description:[[:space:]]*(>|[^[:space:]])' \
    || err "$file 缺少 description"
done
ok "$skill_count 个 SKILL.md 已检查"

echo "== 3. Role and validate-mode routing =="
role_count=0
for file in "$REF"/roles/*.md; do
  role_count=$((role_count + 1))
  role=$(basename "$file" .md)
  grep -Fq -- "$role" "$REF/role-routing.md" \
    || err "角色 $role 未在 role-routing.md 登记"
done
ok "$role_count 个角色卡已检查"

mode_count=0
for file in "$REF"/validate-modes/*.md; do
  mode_count=$((mode_count + 1))
  mode=$(basename "$file" .md)
  grep -Fq -- "$mode" "$REF/role-routing.md" \
    || err "验证模式 $mode 未在 role-routing.md 登记"
  grep -Fq -- "$mode" "$ROOT/sdlc-validate/SKILL.md" \
    || err "验证模式 $mode 未被 sdlc-validate 引用"
done
ok "$mode_count 个验证模式已检查"

echo "== 4. Language packs =="
language_count=0
for file in "$REF"/languages/*.md; do
  language_count=$((language_count + 1))
  language=$(basename "$file" .md)
  head -n 8 "$file" | grep -qE '^lang:' || err "$file 缺少 lang frontmatter"
  grep -Fq -- "languages/$language" "$REF/role-routing.md" \
    || err "语言包 $language 未在 role-routing.md 登记"
done
ok "$language_count 个语言包已检查"

echo "== 5. Local Markdown references =="
if python3 - <<'PY'
from pathlib import Path
import re

roots = [Path("README.md"), Path("CLAUDE.md"), Path("docs/testing.md")]
roots.extend(Path("skills").rglob("*.md"))
missing = []

for source in roots:
    text = source.read_text(encoding="utf-8")
    for raw_target in re.findall(r"\]\(([^)]+)\)", text):
        target = raw_target.strip().split(maxsplit=1)[0].strip("<>")
        target = target.split("#", 1)[0]
        if not target or target.startswith(("http://", "https://", "mailto:")):
            continue
        if any(marker in target for marker in ("<", ">", "*")):
            continue
        resolved = (source.parent / target).resolve()
        if not resolved.exists():
            missing.append(f"{source}: {raw_target}")

if missing:
    print("\n".join(f"missing local reference: {item}" for item in missing))
    raise SystemExit(1)
PY
then
  ok "本地 Markdown 引用均存在"
else
  err "存在悬空的本地 Markdown 引用"
fi

echo "== 6. Long-lived context integration =="
for expected in \
  "$ROOT/sdlc-onboard/SKILL.md:.repo-context/manifest.yaml" \
  "$ROOT/sdlc/references/templates/PROJECT.md:Repository context sources" \
  "$ROOT/sdlc-product-design/SKILL.md:发布后观察窗口" \
  "$ROOT/sdlc-plan/SKILL.md:发布后观察" \
  "$ROOT/sdlc-ship/SKILL.md:发布后观察记录"; do
  file=${expected%%:*}
  text=${expected#*:}
  grep -Fq -- "$text" "$file" || err "$file 缺少长期上下文协作约束: $text"
done
ok "长期上下文协作约束已检查"

echo "== 7. Project-level architecture constraint references =="
# One checker for reference presence and anchor reachability of the shared
# subsection; the same function runs on temporary fixture copies below so a
# removed reference or unreachable anchor is rejected without editing the
# real working tree.
check_arch_constraint_refs() {
  local shared=$1
  shift
  PYTHONDONTWRITEBYTECODE=1 python3 - "$shared" "$@" <<'PY'
from pathlib import Path
import re
import sys

shared = Path(sys.argv[1]).resolve()
scanned = [Path(p) for p in sys.argv[2:]]

def slug(text):
    return re.sub(r"[^\w\- ]", "", text.strip().lower()).replace(" ", "-")

anchors = set()
for line in shared.read_text(encoding="utf-8").splitlines():
    heading = re.match(r"^#{1,6}\s+(.*?)\s*$", line)
    if heading:
        anchors.add(slug(heading.group(1)))

errors = []
required_anchor = "项目级架构约束"
if required_anchor not in anchors:
    errors.append(f"{shared}: 缺少共享小节锚点 #{required_anchor}")

for path in scanned:
    text = path.read_text(encoding="utf-8")
    has_required_reference = False
    for url in re.findall(r"\]\(([^)]+)\)", text):
        if "#" not in url:
            continue
        target, fragment = url.split("#", 1)
        resolved = (path.parent / target).resolve() if target else path.resolve()
        if resolved != shared:
            continue
        if fragment not in anchors:
            errors.append(f"{path}: 共享小节锚点不可达 #{fragment}")
        if fragment == required_anchor:
            has_required_reference = True
    if not has_required_reference:
        errors.append(f"{path}: 缺少到共享正文 #{required_anchor} 的引用")

if errors:
    print("\n".join(errors))
    raise SystemExit(1)
PY
}

arch_shared="$REF/lifecycles/software-delivery.md"
arch_expected=(
  "$ROOT/sdlc-software-delivery/SKILL.md"
  "$ROOT/sdlc-onboard/SKILL.md"
  "$ROOT/sdlc-plan/SKILL.md"
  "$ROOT/sdlc-build/SKILL.md"
  "$ROOT/sdlc-validate/SKILL.md"
  "$ROOT/sdlc-review/SKILL.md"
  "$REF/templates/PROJECT.md"
  "$REF/templates/ENGINEERING.md"
  "README.md"
  "$arch_shared"
)
if check_arch_constraint_refs "$arch_shared" "${arch_expected[@]}"; then
  ok "项目级架构约束引用与共享小节锚点已检查"
else
  err "项目级架构约束引用缺失或共享小节锚点不可达"
fi

arch_fixture=$(mktemp -d "${TMPDIR:-/tmp}/sdlc-arch-refs.XXXXXX") || {
  err "无法创建项目级架构约束引用测试临时目录"
  arch_fixture=""
}
if [ -n "$arch_fixture" ]; then
  trap 'rm -rf "$arch_fixture"' EXIT
  mkdir -p "$arch_fixture/sdlc-build" "$arch_fixture/sdlc/references/lifecycles" "$arch_fixture/sdlc/references/templates"
  cp "$arch_shared" "$arch_fixture/sdlc/references/lifecycles/software-delivery.md"
  cp "$ROOT/sdlc-build/SKILL.md" "$arch_fixture/sdlc-build/SKILL.md"
  cp "$REF/templates/PROJECT.md" "$arch_fixture/sdlc/references/templates/PROJECT.md"

  if check_arch_constraint_refs \
    "$arch_fixture/sdlc/references/lifecycles/software-delivery.md" \
    "$arch_fixture/sdlc-build/SKILL.md" \
    "$arch_fixture/sdlc/references/templates/PROJECT.md"; then
    ok "项目级架构约束引用正例已执行"
  else
    err "项目级架构约束引用正例失败"
  fi

  # Retain the labels and surrounding prose: only remove the required links.
  python3 - "$arch_fixture/sdlc-build/SKILL.md" "$arch_fixture/sdlc-build/missing-ref.md" <<'PY'
from pathlib import Path
import re
import sys

source = Path(sys.argv[1]).read_text(encoding="utf-8")
without_links = re.sub(
    r"\[([^\]]+)\]\([^)]*software-delivery\.md#项目级架构约束\)",
    r"\1",
    source,
)
Path(sys.argv[2]).write_text(without_links, encoding="utf-8")
PY
  if check_arch_constraint_refs \
    "$arch_fixture/sdlc/references/lifecycles/software-delivery.md" \
    "$arch_fixture/sdlc-build/missing-ref.md"; then
    err "删除必要引用的反例未被拒绝"
  else
    ok "删除必要引用反例已拒绝"
  fi

  sed 's/#项目级架构约束/#不存在的锚点/' \
    "$arch_fixture/sdlc-build/SKILL.md" > "$arch_fixture/sdlc-build/bad-anchor.md"
  if check_arch_constraint_refs \
    "$arch_fixture/sdlc/references/lifecycles/software-delivery.md" \
    "$arch_fixture/sdlc-build/bad-anchor.md"; then
    err "失效目标锚点的反例未被拒绝"
  else
    ok "失效目标锚点反例已拒绝"
  fi
fi

# These scoped checks validate documentation shape, not host behavior.
check_t3_child_contract() {
  local adapter="$1" protocol="$2" template="$3" readme="$4"
  for token in delegate_task task_cancel 'terminal executor' 'host `next`'; do
    grep -Fq -- "$token" "$adapter" || return 1
  done
  for token in 'runtime-adapters/t3-code.md' 'host `next`'; do
    grep -Fq -- "$token" "$protocol" || return 1
  done
  grep -Fq -- '终端执行者' "$template" || return 1
  grep -Fq -- 'stage-agent-protocol.md' "$adapter" || return 1
  grep -Fq -- 'SCN-t3-stage-dispatch' "$readme" || return 1
  grep -Fq -- 'runtime-adapters/t3-code.md' "$readme" || return 1
  # Reject the old affirmative top-level stage sequence, not native mappings or prohibitions.
  if grep -Fq -- 'Launch idle via `t3_thread_launch`' "$adapter"; then return 1; fi
}

echo "== 8. Stage agent orchestration =="
if check_t3_child_contract "$REF/runtime-adapters/t3-code.md" "$REF/stage-agent-protocol.md" "$REF/templates/TASK.md" "README.md"; then
  ok "T3 child 文档合同形状已检查"
else
  err "T3 child 文档合同形状缺失或保留旧阶段路径"
fi
for expected in \
  "$ROOT/sdlc/SKILL.md:stage-agent-protocol.md" \
  "$REF/role-routing.md:stage-agent-protocol.md" \
  "$REF/evolve-loop.md:stage-agent-protocol.md" \
  "$REF/roles/skill-maintainer.md:stage-agent-protocol.md" \
  "$REF/runtime-adapters/codex.md:stage-agent-protocol.md" \
  "$REF/runtime-adapters/codex.md:spawn_agent" \
  "$REF/runtime-adapters/codex.md:interrupt_agent" \
  "$REF/runtime-adapters/codex.md:list_agents" \
  "$REF/stage-agent-protocol.md:sole authority" \
  "$REF/stage-agent-protocol.md:awaiting_acceptance | incomplete | blocked" \
  "$REF/stage-agent-protocol.md:allowed_transitions" \
  "$REF/stage-agent-protocol.md:record-validation --result fail" \
  "$REF/stage-agent-protocol.md:checkpoints/<feature-id>.md" \
  "$REF/templates/TASK.md:allowed_transitions:" \
  "$REF/templates/TASK.md:[] # no lifecycle mutation for this brief" \
  "$REF/templates/TASK.md:--repo" \
  "$REF/templates/TASK.md:required_verification" \
  "$REF/templates/TASK.md:supersedes" \
  "$REF/templates/TASK.md:awaiting_acceptance | incomplete | blocked" \
  "$REF/templates/TASK.md:workspace_status" \
  "$REF/templates/TASK.md:requested_transitions" \
  "$REF/templates/CHECKPOINT.md:## 定位" \
  "$REF/templates/CHECKPOINT.md:## 已确认" \
  "$REF/templates/CHECKPOINT.md:## 未完成" \
  "$REF/templates/CHECKPOINT.md:## 下一步" \
  "$REF/templates/CHECKPOINT.md:## 必要引用" \
  "$ROOT/sdlc-plan/SKILL.md:start-feature --help"; do
  file=${expected%%:*}
  text=${expected#*:}
  grep -Fq -- "$text" "$file" || err "$file 缺少阶段 Agent 协作约束: $text"
done

for stage in onboard backlog product-design spec plan build validate review ship; do
  file="$ROOT/sdlc-$stage/SKILL.md"
  grep -Fq -- "stage-agent-protocol.md" "$file" \
    || err "$file 未引用阶段 Agent 协议"
done
grep -Fq -- "stage-agent-protocol.md" "$ROOT/sdlc-software-delivery/SKILL.md" \
  || err "$ROOT/sdlc-software-delivery/SKILL.md 未引用阶段 Agent 协议"

check_checkpoint_shape() {
  local file=$1
  local sections
  local lines
  local headings

  sections=$(grep -Ec '^## ' "$file")
  lines=$(wc -l < "$file" | tr -d '[:space:]')
  headings=$(grep -E '^## ' "$file" | paste -sd '|' -)

  [ "$sections" -eq 5 ] || return 1
  [ "$lines" -le 60 ] || return 1
  [ "$headings" = '## 定位|## 已确认|## 未完成|## 下一步|## 必要引用' ]
}

check_child_result_status() {
  local file=$1
  local status

  status=$(grep -E '^status:[[:space:]]*' "$file" | head -n 1 | sed -E 's/^status:[[:space:]]*//')
  case "$status" in
    awaiting_acceptance|incomplete|blocked)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

if check_checkpoint_shape "$REF/templates/CHECKPOINT.md"; then
  ok "checkpoint 模板固定五节、顺序和 60 行限制已检查"
else
  err "$REF/templates/CHECKPOINT.md 必须按固定顺序保留五节且不超过 60 行"
fi

# These fixtures execute the document-shape checks against real temporary copies.
# They do not replace the main Agent's semantic authorization or acceptance review.
checkpoint_fixture=$(mktemp -d "${TMPDIR:-/tmp}/sdlc-checkpoint-shape.XXXXXX") || {
  err "无法创建 checkpoint 形状测试临时目录"
  checkpoint_fixture=""
}
if [ -n "$checkpoint_fixture" ]; then
  trap 'rm -rf "$checkpoint_fixture" "$arch_fixture"' EXIT

  cp "$REF/templates/CHECKPOINT.md" "$checkpoint_fixture/valid.md"
  if check_checkpoint_shape "$checkpoint_fixture/valid.md"; then
    ok "checkpoint 合法模板正例已执行"
  else
    err "checkpoint 合法模板正例失败"
  fi

  grep -v '^## 已确认$' "$checkpoint_fixture/valid.md" > "$checkpoint_fixture/missing.md"
  if check_checkpoint_shape "$checkpoint_fixture/missing.md"; then
    err "checkpoint 缺少固定章节的反例未被拒绝"
  else
    ok "checkpoint 缺少固定章节反例已拒绝"
  fi

  cp "$checkpoint_fixture/valid.md" "$checkpoint_fixture/extra.md"
  printf '\n## 额外\n' >> "$checkpoint_fixture/extra.md"
  if check_checkpoint_shape "$checkpoint_fixture/extra.md"; then
    err "checkpoint 额外章节反例未被拒绝"
  else
    ok "checkpoint 额外章节反例已拒绝"
  fi

  cp "$checkpoint_fixture/valid.md" "$checkpoint_fixture/over-limit.md"
  while [ "$(wc -l < "$checkpoint_fixture/over-limit.md" | tr -d '[:space:]')" -le 60 ]; do
    printf '# filler\n' >> "$checkpoint_fixture/over-limit.md"
  done
  if check_checkpoint_shape "$checkpoint_fixture/over-limit.md"; then
    err "checkpoint 超过 60 行反例未被拒绝"
  else
    ok "checkpoint 超过 60 行反例已拒绝"
  fi

  printf 'status: awaiting_acceptance\n' > "$checkpoint_fixture/result-valid.yaml"
  printf 'status: completed\n' > "$checkpoint_fixture/result-legacy.yaml"
  if check_child_result_status "$checkpoint_fixture/result-valid.yaml"; then
    ok "子 Agent 当前结果状态正例已执行"
  else
    err "子 Agent 当前结果状态正例失败"
  fi
  if check_child_result_status "$checkpoint_fixture/result-legacy.yaml"; then
    err "旧 completed 结果反例未被拒绝"
  else
    ok "旧 completed 结果反例已拒绝"
  fi
fi

# Test the scoped contract against temporary copies and representative omissions.
t3_fixture=$(mktemp -d "${TMPDIR:-/tmp}/sdlc-t3-contract.XXXXXX") || {
  err "无法创建 T3 合同测试临时目录"
  t3_fixture=""
}
if [ -n "$t3_fixture" ]; then
  trap 'rm -rf "$checkpoint_fixture" "$arch_fixture" "$t3_fixture"' EXIT
  cp "$REF/runtime-adapters/t3-code.md" "$t3_fixture/adapter.md"
  cp "$REF/stage-agent-protocol.md" "$t3_fixture/protocol.md"
  cp "$REF/templates/TASK.md" "$t3_fixture/task.md"
  cp README.md "$t3_fixture/readme.md"
  if check_t3_child_contract "$t3_fixture/adapter.md" "$t3_fixture/protocol.md" "$t3_fixture/task.md" "$t3_fixture/readme.md"; then
    ok "T3 合同副本正例已执行"
  else
    err "T3 合同副本正例失败"
  fi
  grep -v 'terminal executor' "$t3_fixture/adapter.md" > "$t3_fixture/no-terminal.md"
  if check_t3_child_contract "$t3_fixture/no-terminal.md" "$t3_fixture/protocol.md" "$t3_fixture/task.md" "$t3_fixture/readme.md"; then
    err "缺少终端执行者反例未被拒绝"
  else
    ok "缺少终端执行者反例已拒绝"
  fi
  cp "$t3_fixture/adapter.md" "$t3_fixture/old-path.md"
  printf '\nLaunch idle via `t3_thread_launch`\n' >> "$t3_fixture/old-path.md"
  if check_t3_child_contract "$t3_fixture/old-path.md" "$t3_fixture/protocol.md" "$t3_fixture/task.md" "$t3_fixture/readme.md"; then
    err "旧 top-level 阶段路径反例未被拒绝"
  else
    ok "旧 top-level 阶段路径反例已拒绝"
  fi
  grep -v 'runtime-adapters/t3-code.md' "$t3_fixture/protocol.md" > "$t3_fixture/no-reference.md"
  if check_t3_child_contract "$t3_fixture/adapter.md" "$t3_fixture/no-reference.md" "$t3_fixture/task.md" "$t3_fixture/readme.md"; then
    err "缺少 T3 引用反例未被拒绝"
  else
    ok "缺少 T3 引用反例已拒绝"
  fi
fi

# These checks intentionally cover document shape only. The main Agent must still
# make the semantic dispatch, acceptance, and parallelism decisions at runtime.
for forbidden in \
  "$REF/templates/TASK.md:status: <completed" \
  "$REF/templates/TASK.md:status: <failed" \
  "$REF/roles/client-dev.md:并行加载本卡" \
  "$REF/roles/client-dev.md:review/client-dev.md" \
  "$REF/collaboration-discipline.md:git switch main" \
  "$REF/collaboration-discipline.md:origin/main" \
  "$REF/divergence-frames.md:并行起 5 个 agent"; do
  file=${forbidden%%:*}
  text=${forbidden#*:}
  if grep -Fq -- "$text" "$file"; then
    err "$file 保留冲突的阶段 Agent 文案: $text"
  fi
done
ok "阶段 Agent 编排形状和冲突反例已检查"

echo "== 9. Portability =="
for file in "$ROOT"/*/SKILL.md; do
  if grep -q "AskUserQuestion" "$file" && ! grep -q "text_mode" "$file"; then
    err "$file 使用 AskUserQuestion 但未声明 text_mode 降级"
  fi
done
ok "可移植性文本检查完成"

echo "== 10. Focused tests =="
for test_file in \
  scripts/test_lifecycle_state.py \
  scripts/test_backlog.py \
  scripts/test_scenarios.py \
  scripts/test_contrast_check.py \
  scripts/test_hallmark_catalog.py \
  scripts/test_vibe_test.py \
  scripts/test_vibe_host.py \
  scripts/test_security_dependency.py; do
  if PYTHONDONTWRITEBYTECODE=1 python3 -B "$test_file"; then
    ok "$test_file"
  else
    err "$test_file 失败"
  fi
done

echo
if [ "$fail" -eq 0 ]; then
  echo "RESULT: PASS"
  exit 0
fi

echo "RESULT: $fail 项不一致"
exit 1
