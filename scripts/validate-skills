#!/usr/bin/env bash
# Fast, dependency-free repository checks for the lightweight SDLC.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 2

ROOT="skills"
REF="$ROOT/sdlc/references"
fail=0

err() {
  echo "  ✗ $1"
  fail=$((fail + 1))
}

ok() {
  echo "  ✓ $1"
}

echo "== 1. Lightweight runtime and shared references =="
for path in \
  scripts/lifecycle_state.py \
  scripts/backlog.py \
  scripts/board.py \
  scripts/contrast_check.py \
  scripts/test_lifecycle_state.py \
  scripts/test_backlog.py \
  scripts/test_contrast_check.py \
  "$REF/role-routing.md" \
  "$REF/lightweight-runtime.md" \
  "$REF/lifecycles/product-design.md" \
  "$REF/lifecycles/software-delivery.md" \
  "$REF/stage-agent-protocol.md" \
  "$REF/runtime-adapters/codex.md" \
  "$REF/templates/TASK.md" \
  "$REF/templates/CHECKPOINT.md" \
  "$REF/roles" \
  "$REF/validate-modes" \
  "$REF/languages"; do
  if [ -e "$path" ]; then
    ok "$path"
  else
    err "缺失: $path"
  fi
done

echo "== 2. Skill frontmatter =="
skill_count=0
for file in "$ROOT"/*/SKILL.md; do
  skill_count=$((skill_count + 1))
  first_line=$(head -n 1 "$file")
  [ "$first_line" = "---" ] || err "$file 首行不是 ---"
  head -n 20 "$file" | grep -qE '^name:[[:space:]]*[^[:space:]]' \
    || err "$file 缺少 name"
  head -n 20 "$file" | grep -qE '^description:[[:space:]]*(>|[^[:space:]])' \
    || err "$file 缺少 description"
done
ok "$skill_count 个 SKILL.md 已检查"

echo "== 3. Role and validate-mode routing =="
role_count=0
for file in "$REF"/roles/*.md; do
  role_count=$((role_count + 1))
  role=$(basename "$file" .md)
  grep -Fq -- "$role" "$REF/role-routing.md" \
    || err "角色 $role 未在 role-routing.md 登记"
done
ok "$role_count 个角色卡已检查"

mode_count=0
for file in "$REF"/validate-modes/*.md; do
  mode_count=$((mode_count + 1))
  mode=$(basename "$file" .md)
  grep -Fq -- "$mode" "$REF/role-routing.md" \
    || err "验证模式 $mode 未在 role-routing.md 登记"
  grep -Fq -- "$mode" "$ROOT/sdlc-validate/SKILL.md" \
    || err "验证模式 $mode 未被 sdlc-validate 引用"
done
ok "$mode_count 个验证模式已检查"

echo "== 4. Language packs =="
language_count=0
for file in "$REF"/languages/*.md; do
  language_count=$((language_count + 1))
  language=$(basename "$file" .md)
  head -n 8 "$file" | grep -qE '^lang:' || err "$file 缺少 lang frontmatter"
  grep -Fq -- "languages/$language" "$REF/role-routing.md" \
    || err "语言包 $language 未在 role-routing.md 登记"
done
ok "$language_count 个语言包已检查"

echo "== 5. Local Markdown references =="
if python3 - <<'PY'
from pathlib import Path
import re

roots = [Path("README.md"), Path("CLAUDE.md")]
roots.extend(Path("skills").rglob("*.md"))
missing = []

for source in roots:
    text = source.read_text(encoding="utf-8")
    for raw_target in re.findall(r"\]\(([^)]+)\)", text):
        target = raw_target.strip().split(maxsplit=1)[0].strip("<>")
        target = target.split("#", 1)[0]
        if not target or target.startswith(("http://", "https://", "mailto:")):
            continue
        if any(marker in target for marker in ("<", ">", "*")):
            continue
        resolved = (source.parent / target).resolve()
        if not resolved.exists():
            missing.append(f"{source}: {raw_target}")

if missing:
    print("\n".join(f"missing local reference: {item}" for item in missing))
    raise SystemExit(1)
PY
then
  ok "本地 Markdown 引用均存在"
else
  err "存在悬空的本地 Markdown 引用"
fi

echo "== 6. Long-lived context integration =="
for expected in \
  "$ROOT/sdlc-onboard/SKILL.md:.repo-context/manifest.yaml" \
  "$ROOT/sdlc/references/templates/PROJECT.md:Repository context sources" \
  "$ROOT/sdlc-product-design/SKILL.md:发布后观察窗口" \
  "$ROOT/sdlc-plan/SKILL.md:发布后观察" \
  "$ROOT/sdlc-ship/SKILL.md:发布后观察记录"; do
  file=${expected%%:*}
  text=${expected#*:}
  grep -Fq -- "$text" "$file" || err "$file 缺少长期上下文协作约束: $text"
done
ok "长期上下文协作约束已检查"

echo "== 7. Stage agent orchestration =="
for expected in \
  "$ROOT/sdlc/SKILL.md:stage-agent-protocol.md" \
  "$REF/role-routing.md:stage-agent-protocol.md" \
  "$REF/evolve-loop.md:stage-agent-protocol.md" \
  "$REF/roles/skill-maintainer.md:stage-agent-protocol.md" \
  "$REF/runtime-adapters/codex.md:stage-agent-protocol.md" \
  "$REF/runtime-adapters/codex.md:spawn_agent" \
  "$REF/runtime-adapters/codex.md:interrupt_agent" \
  "$REF/runtime-adapters/codex.md:list_agents" \
  "$REF/stage-agent-protocol.md:sole authority" \
  "$REF/stage-agent-protocol.md:awaiting_acceptance | incomplete | blocked" \
  "$REF/stage-agent-protocol.md:allowed_transitions" \
  "$REF/stage-agent-protocol.md:record-validation --result fail" \
  "$REF/stage-agent-protocol.md:checkpoints/<feature-id>.md" \
  "$REF/templates/TASK.md:allowed_transitions:" \
  "$REF/templates/TASK.md:[] # no lifecycle mutation for this brief" \
  "$REF/templates/TASK.md:--repo" \
  "$REF/templates/TASK.md:required_verification" \
  "$REF/templates/TASK.md:supersedes" \
  "$REF/templates/TASK.md:awaiting_acceptance | incomplete | blocked" \
  "$REF/templates/TASK.md:workspace_status" \
  "$REF/templates/TASK.md:requested_transitions" \
  "$REF/templates/CHECKPOINT.md:## 定位" \
  "$REF/templates/CHECKPOINT.md:## 已确认" \
  "$REF/templates/CHECKPOINT.md:## 未完成" \
  "$REF/templates/CHECKPOINT.md:## 下一步" \
  "$REF/templates/CHECKPOINT.md:## 必要引用" \
  "$ROOT/sdlc-plan/SKILL.md:start-feature --help"; do
  file=${expected%%:*}
  text=${expected#*:}
  grep -Fq -- "$text" "$file" || err "$file 缺少阶段 Agent 协作约束: $text"
done

for stage in onboard backlog product-design spec plan build validate review ship; do
  file="$ROOT/sdlc-$stage/SKILL.md"
  grep -Fq -- "stage-agent-protocol.md" "$file" \
    || err "$file 未引用阶段 Agent 协议"
done
grep -Fq -- "stage-agent-protocol.md" "$ROOT/sdlc-software-delivery/SKILL.md" \
  || err "$ROOT/sdlc-software-delivery/SKILL.md 未引用阶段 Agent 协议"

check_checkpoint_shape() {
  local file=$1
  local sections
  local lines
  local headings

  sections=$(grep -Ec '^## ' "$file")
  lines=$(wc -l < "$file" | tr -d '[:space:]')
  headings=$(grep -E '^## ' "$file" | paste -sd '|' -)

  [ "$sections" -eq 5 ] || return 1
  [ "$lines" -le 60 ] || return 1
  [ "$headings" = '## 定位|## 已确认|## 未完成|## 下一步|## 必要引用' ]
}

check_child_result_status() {
  local file=$1
  local status

  status=$(grep -E '^status:[[:space:]]*' "$file" | head -n 1 | sed -E 's/^status:[[:space:]]*//')
  case "$status" in
    awaiting_acceptance|incomplete|blocked)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

if check_checkpoint_shape "$REF/templates/CHECKPOINT.md"; then
  ok "checkpoint 模板固定五节、顺序和 60 行限制已检查"
else
  err "$REF/templates/CHECKPOINT.md 必须按固定顺序保留五节且不超过 60 行"
fi

# These fixtures execute the document-shape checks against real temporary copies.
# They do not replace the main Agent's semantic authorization or acceptance review.
checkpoint_fixture=$(mktemp -d "${TMPDIR:-/tmp}/sdlc-checkpoint-shape.XXXXXX") || {
  err "无法创建 checkpoint 形状测试临时目录"
  checkpoint_fixture=""
}
if [ -n "$checkpoint_fixture" ]; then
  trap 'rm -rf "$checkpoint_fixture"' EXIT

  cp "$REF/templates/CHECKPOINT.md" "$checkpoint_fixture/valid.md"
  if check_checkpoint_shape "$checkpoint_fixture/valid.md"; then
    ok "checkpoint 合法模板正例已执行"
  else
    err "checkpoint 合法模板正例失败"
  fi

  grep -v '^## 已确认$' "$checkpoint_fixture/valid.md" > "$checkpoint_fixture/missing.md"
  if check_checkpoint_shape "$checkpoint_fixture/missing.md"; then
    err "checkpoint 缺少固定章节的反例未被拒绝"
  else
    ok "checkpoint 缺少固定章节反例已拒绝"
  fi

  cp "$checkpoint_fixture/valid.md" "$checkpoint_fixture/extra.md"
  printf '\n## 额外\n' >> "$checkpoint_fixture/extra.md"
  if check_checkpoint_shape "$checkpoint_fixture/extra.md"; then
    err "checkpoint 额外章节反例未被拒绝"
  else
    ok "checkpoint 额外章节反例已拒绝"
  fi

  cp "$checkpoint_fixture/valid.md" "$checkpoint_fixture/over-limit.md"
  while [ "$(wc -l < "$checkpoint_fixture/over-limit.md" | tr -d '[:space:]')" -le 60 ]; do
    printf '# filler\n' >> "$checkpoint_fixture/over-limit.md"
  done
  if check_checkpoint_shape "$checkpoint_fixture/over-limit.md"; then
    err "checkpoint 超过 60 行反例未被拒绝"
  else
    ok "checkpoint 超过 60 行反例已拒绝"
  fi

  printf 'status: awaiting_acceptance\n' > "$checkpoint_fixture/result-valid.yaml"
  printf 'status: completed\n' > "$checkpoint_fixture/result-legacy.yaml"
  if check_child_result_status "$checkpoint_fixture/result-valid.yaml"; then
    ok "子 Agent 当前结果状态正例已执行"
  else
    err "子 Agent 当前结果状态正例失败"
  fi
  if check_child_result_status "$checkpoint_fixture/result-legacy.yaml"; then
    err "旧 completed 结果反例未被拒绝"
  else
    ok "旧 completed 结果反例已拒绝"
  fi
fi

# These checks intentionally cover document shape only. The main Agent must still
# make the semantic dispatch, acceptance, and parallelism decisions at runtime.
for forbidden in \
  "$REF/templates/TASK.md:status: <completed" \
  "$REF/templates/TASK.md:status: <failed" \
  "$REF/roles/client-dev.md:并行加载本卡" \
  "$REF/roles/client-dev.md:review/client-dev.md" \
  "$REF/collaboration-discipline.md:git switch main" \
  "$REF/collaboration-discipline.md:origin/main" \
  "$REF/divergence-frames.md:并行起 5 个 agent"; do
  file=${forbidden%%:*}
  text=${forbidden#*:}
  if grep -Fq -- "$text" "$file"; then
    err "$file 保留冲突的阶段 Agent 文案: $text"
  fi
done
ok "阶段 Agent 编排形状和冲突反例已检查"

echo "== 8. Portability =="
for file in "$ROOT"/*/SKILL.md; do
  if grep -q "AskUserQuestion" "$file" && ! grep -q "text_mode" "$file"; then
    err "$file 使用 AskUserQuestion 但未声明 text_mode 降级"
  fi
done
ok "可移植性文本检查完成"

echo "== 9. Focused tests =="
for test_file in \
  scripts/test_lifecycle_state.py \
  scripts/test_backlog.py \
  scripts/test_contrast_check.py; do
  if PYTHONDONTWRITEBYTECODE=1 python3 "$test_file"; then
    ok "$test_file"
  else
    err "$test_file 失败"
  fi
done

echo
if [ "$fail" -eq 0 ]; then
  echo "RESULT: PASS"
  exit 0
fi

echo "RESULT: $fail 项不一致"
exit 1
