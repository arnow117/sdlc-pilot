#!/usr/bin/env bash
# Fast, dependency-free repository checks for the lightweight SDLC.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 2

ROOT="skills"
REF="$ROOT/sdlc/references"
fail=0

err() {
  echo "  ✗ $1"
  fail=$((fail + 1))
}

ok() {
  echo "  ✓ $1"
}

echo "== 1. Lightweight runtime and shared references =="
for path in \
  scripts/lifecycle_state.py \
  scripts/backlog.py \
  scripts/board.py \
  scripts/contrast_check.py \
  scripts/test_lifecycle_state.py \
  scripts/test_backlog.py \
  scripts/test_contrast_check.py \
  "$REF/role-routing.md" \
  "$REF/lightweight-runtime.md" \
  "$REF/lifecycles/product-design.md" \
  "$REF/lifecycles/software-delivery.md" \
  "$REF/stage-agent-protocol.md" \
  "$REF/runtime-adapters/codex.md" \
  "$REF/roles" \
  "$REF/validate-modes" \
  "$REF/languages"; do
  if [ -e "$path" ]; then
    ok "$path"
  else
    err "缺失: $path"
  fi
done

echo "== 2. Skill frontmatter =="
skill_count=0
for file in "$ROOT"/*/SKILL.md; do
  skill_count=$((skill_count + 1))
  first_line=$(head -n 1 "$file")
  [ "$first_line" = "---" ] || err "$file 首行不是 ---"
  head -n 20 "$file" | grep -qE '^name:[[:space:]]*[^[:space:]]' \
    || err "$file 缺少 name"
  head -n 20 "$file" | grep -qE '^description:[[:space:]]*(>|[^[:space:]])' \
    || err "$file 缺少 description"
done
ok "$skill_count 个 SKILL.md 已检查"

echo "== 3. Role and validate-mode routing =="
role_count=0
for file in "$REF"/roles/*.md; do
  role_count=$((role_count + 1))
  role=$(basename "$file" .md)
  grep -Fq -- "$role" "$REF/role-routing.md" \
    || err "角色 $role 未在 role-routing.md 登记"
done
ok "$role_count 个角色卡已检查"

mode_count=0
for file in "$REF"/validate-modes/*.md; do
  mode_count=$((mode_count + 1))
  mode=$(basename "$file" .md)
  grep -Fq -- "$mode" "$REF/role-routing.md" \
    || err "验证模式 $mode 未在 role-routing.md 登记"
  grep -Fq -- "$mode" "$ROOT/sdlc-validate/SKILL.md" \
    || err "验证模式 $mode 未被 sdlc-validate 引用"
done
ok "$mode_count 个验证模式已检查"

echo "== 4. Language packs =="
language_count=0
for file in "$REF"/languages/*.md; do
  language_count=$((language_count + 1))
  language=$(basename "$file" .md)
  head -n 8 "$file" | grep -qE '^lang:' || err "$file 缺少 lang frontmatter"
  grep -Fq -- "languages/$language" "$REF/role-routing.md" \
    || err "语言包 $language 未在 role-routing.md 登记"
done
ok "$language_count 个语言包已检查"

echo "== 5. Local Markdown references =="
if python3 - <<'PY'
from pathlib import Path
import re

roots = [Path("README.md"), Path("CLAUDE.md")]
roots.extend(Path("skills").rglob("*.md"))
missing = []

for source in roots:
    text = source.read_text(encoding="utf-8")
    for raw_target in re.findall(r"\]\(([^)]+)\)", text):
        target = raw_target.strip().split(maxsplit=1)[0].strip("<>")
        target = target.split("#", 1)[0]
        if not target or target.startswith(("http://", "https://", "mailto:")):
            continue
        if any(marker in target for marker in ("<", ">", "*")):
            continue
        resolved = (source.parent / target).resolve()
        if not resolved.exists():
            missing.append(f"{source}: {raw_target}")

if missing:
    print("\n".join(f"missing local reference: {item}" for item in missing))
    raise SystemExit(1)
PY
then
  ok "本地 Markdown 引用均存在"
else
  err "存在悬空的本地 Markdown 引用"
fi

echo "== 6. Long-lived context integration =="
for expected in \
  "$ROOT/sdlc-onboard/SKILL.md:.repo-context/manifest.yaml" \
  "$ROOT/sdlc/references/templates/PROJECT.md:Repository context sources" \
  "$ROOT/sdlc-product-design/SKILL.md:发布后观察窗口" \
  "$ROOT/sdlc-plan/SKILL.md:发布后观察" \
  "$ROOT/sdlc-ship/SKILL.md:发布后观察记录"; do
  file=${expected%%:*}
  text=${expected#*:}
  grep -Fq -- "$text" "$file" || err "$file 缺少长期上下文协作约束: $text"
done
ok "长期上下文协作约束已检查"

echo "== 7. Stage agent orchestration =="
for expected in \
  "$ROOT/sdlc/SKILL.md:stage-agent-protocol.md" \
  "$ROOT/sdlc/SKILL.md:allowed_transitions" \
  "$REF/runtime-adapters/codex.md:stage-agent-protocol.md" \
  "$REF/stage-agent-protocol.md:allowed_transitions" \
  "$REF/templates/TASK.md:requested_transitions" \
  "$REF/templates/TASK.md:project_candidates" \
  "$REF/templates/TASK.md:allowed_transitions" \
  "$ROOT/sdlc-plan/SKILL.md:start-feature --help"; do
  file=${expected%%:*}
  text=${expected#*:}
  grep -Fq -- "$text" "$file" || err "$file 缺少阶段 Agent 协作约束: $text"
done

for stage in onboard backlog product-design spec plan build validate review ship; do
  file="$ROOT/sdlc-$stage/SKILL.md"
  grep -Fq -- "stage-agent-protocol.md" "$file" \
    || err "$file 未引用阶段 Agent 协议"
done
grep -Fq -- "stage-agent-protocol.md" "$ROOT/sdlc-software-delivery/SKILL.md" \
  || err "$ROOT/sdlc-software-delivery/SKILL.md 未引用阶段 Agent 协议"
ok "阶段 Agent 编排约束已检查"

echo "== 8. Portability =="
for file in "$ROOT"/*/SKILL.md; do
  if grep -q "AskUserQuestion" "$file" && ! grep -q "text_mode" "$file"; then
    err "$file 使用 AskUserQuestion 但未声明 text_mode 降级"
  fi
done
ok "可移植性文本检查完成"

echo "== 9. Focused tests =="
for test_file in \
  scripts/test_lifecycle_state.py \
  scripts/test_backlog.py \
  scripts/test_contrast_check.py; do
  if PYTHONDONTWRITEBYTECODE=1 python3 "$test_file"; then
    ok "$test_file"
  else
    err "$test_file 失败"
  fi
done

echo
if [ "$fail" -eq 0 ]; then
  echo "RESULT: PASS"
  exit 0
fi

echo "RESULT: $fail 项不一致"
exit 1
