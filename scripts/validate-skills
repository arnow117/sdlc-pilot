#!/usr/bin/env bash
# sdlc-pilot 结构 lint —— 可重复回归测试(纯 shell,无依赖)。
# 检查:① 每个 SKILL.md 有合法 frontmatter;② 角色名↔文件↔字典一致;
#       ③ validate 模式名↔文件↔字典一致;④ 关键共享文件存在。
# 用法:bash scripts/validate-skills   (commit 前必跑;退出码 0=通过)
set -u
cd "$(dirname "$0")/.." || exit 2
ROOT="skills"; REF="$ROOT/sdlc/references"
fail=0
err(){ echo "  ✗ $1"; fail=$((fail+1)); }
ok(){ echo "  ✓ $1"; }

echo "== 1. 关键共享文件/目录 =="
for p in "$REF/role-routing.md" "$REF/distillation-loop.md" "$REF/control-plane.md" "$REF/runtime-adapters/codex.md" "$REF/roles" "$REF/validate-modes" "$REF/templates/STATE.md" "$REF/templates/TASK.md" "$REF/templates/PROFILE.md"; do
  [ -e "$p" ] && ok "$p" || err "缺失:$p"
done

echo "== 2. 每个 SKILL.md frontmatter(name + description) =="
for f in "$ROOT"/*/SKILL.md; do
  head -15 "$f" | grep -qE '^name:' || err "$f 缺 name:"
  head -15 "$f" | grep -qE '^description:' || err "$f 缺 description:"
done
[ $fail -eq 0 ] && ok "全部 SKILL.md frontmatter 合法"

echo "== 3. 角色卡:文件 ↔ role-routing 字典 ↔ STATE 模板 =="
for rf in "$REF"/roles/*.md; do
  r="$(basename "$rf" .md)"
  grep -q "$r" "$REF/role-routing.md" || err "角色 '$r' 未在 role-routing.md 出现(字典/规则漏登记)"
  grep -q "$r" "$REF/templates/STATE.md" || err "角色 '$r' 未在 STATE 模板取值字典"
done
ok "角色卡交叉引用检查完成($(ls "$REF"/roles/*.md | wc -l | tr -d ' ') 个)"

echo "== 4. validate 模式:文件 ↔ role-routing ↔ sdlc-validate =="
for mf in "$REF"/validate-modes/*.md; do
  m="$(basename "$mf" .md)"
  grep -q "$m" "$REF/role-routing.md" || err "模式 '$m' 未在 role-routing.md"
  grep -q "$m" "$ROOT/sdlc-validate/SKILL.md" || err "模式 '$m' 未被 sdlc-validate 引用"
done
ok "validate 模式交叉引用检查完成($(ls "$REF"/validate-modes/*.md | wc -l | tr -d ' ') 个)"

echo "== 5. 可移植自检:流程 skill 不得硬依赖 Claude 专属工具 =="
for f in "$ROOT"/*/SKILL.md; do
  # 允许出现在"降级/不依赖"语境;这里只粗查是否完全没提降级却硬用 AskUserQuestion
  if grep -q "AskUserQuestion" "$f" && ! grep -q "text_mode" "$f"; then
    err "$f 提到 AskUserQuestion 但无 text_mode 降级(违反可移植铁律)"
  fi
done
[ $fail -eq 0 ] && ok "可移植自检通过"

echo "== 6. 语言包:文件 ↔ role-routing §7 登记 =="
if [ -d "$REF/languages" ]; then
  for lf in "$REF"/languages/*.md; do
    l="$(basename "$lf" .md)"
    grep -q "languages/$l" "$REF/role-routing.md" || err "语言包 '$l' 未在 role-routing §7 登记"
    head -6 "$lf" | grep -qE '^lang:' || err "$lf 缺 lang: frontmatter"
  done
  ok "语言包检查完成($(ls "$REF"/languages/*.md 2>/dev/null | wc -l | tr -d ' ') 个)"
fi

echo "== 7. control 协议跨流程引用与行为测试 =="
for f in "$ROOT/sdlc/SKILL.md" "$ROOT/sdlc-backlog/SKILL.md" "$ROOT/sdlc-onboard/SKILL.md" "$ROOT/sdlc-plan/SKILL.md" "$ROOT/sdlc-build/SKILL.md" "$ROOT/sdlc-spec/SKILL.md" "$ROOT/sdlc-validate/SKILL.md" "$ROOT/sdlc-review/SKILL.md" "$ROOT/sdlc-ship/SKILL.md"; do
  grep -q "control-plane.md" "$f" || err "$f 未引用 control-plane.md"
done
for f in scripts/test_control.py scripts/test_control_intake.py scripts/test_hooks.py; do
  [ -f "$f" ] && ok "$f" || err "缺失:$f"
done
python3 scripts/test_control_intake.py \
  && ok "control intake 正文行为测试通过" || err "control intake 正文行为测试失败"
for f in scripts/control.py scripts/control_cli.py scripts/control_intake.py scripts/control_lint.py scripts/control_model.py scripts/control_store.py; do
  if [ -f "$f" ]; then
    lines=$(wc -l < "$f" | tr -d ' ')
    [ "$lines" -lt 1000 ] && ok "$f(${lines} lines)" || err "$f 达 ${lines} 行,需拆分(<1000)"
  else
    err "缺失:$f"
  fi
done
python3 -m py_compile scripts/control.py scripts/control_cli.py scripts/control_intake.py scripts/control_lint.py scripts/control_model.py scripts/control_store.py \
  && ok "control modules 可导入/编译" || err "control modules 编译失败"
[ -f docs/adr/0001-sdlc-control-branch.md ] && ok "control ADR 存在" || err "缺失 control ADR"
grep -q "docs/adr/0001-sdlc-control-branch.md" "$REF/control-plane.md" \
  || err "control-plane.md 未引用 control ADR"
grep -q "/sdlc intake" "$ROOT/sdlc/SKILL.md" || err "driver 缺 /sdlc intake"
grep -q "/sdlc deliver" "$ROOT/sdlc/SKILL.md" || err "driver 缺 /sdlc deliver"
grep -q "depends_on_tasks" "$ROOT/sdlc-plan/SKILL.md" || err "sdlc-plan 缺 Task 依赖字段"
grep -q "write_set" "$ROOT/sdlc-plan/SKILL.md" || err "sdlc-plan 缺 Task write_set 字段"
grep -q "TASK.md" "$ROOT/sdlc-build/SKILL.md" || err "sdlc-build 未接入 TASK identity"
grep -q "integration_sha" "$ROOT/sdlc-build/SKILL.md" || err "sdlc-build 未引用 integration_sha"
grep -q "tested_sha" "$ROOT/sdlc-validate/SKILL.md" || err "sdlc-validate 未引用 tested_sha evidence"

echo "== 8. 强门禁脚本 sdlc-guard 随技能自包含且可执行 =="
GUARD="$ROOT/sdlc/scripts/sdlc-guard"
if [ -f "$GUARD" ]; then
  [ -x "$GUARD" ] && ok "$GUARD(存在且可执行)" || err "$GUARD 不可执行(chmod +x)"
  # hook 模板的查找路径必须指向 skills/sdlc/scripts(三种安装方式一致)
  grep -q "skills/sdlc/scripts/sdlc-guard" "$REF/templates/hooks/pre-commit" \
    || err "pre-commit hook 未按 skills/sdlc/scripts/ 查找 sdlc-guard(路径漂移)"
else
  err "缺失:$GUARD(强门禁脚本应随 sdlc 技能自包含)"
fi
for f in "$GUARD" "$REF"/templates/hooks/pre-commit "$REF"/templates/hooks/pre-push "$REF"/templates/hooks/post-checkout; do
  sh -n "$f" || err "$f shell syntax 无效"
done

echo
if [ $fail -eq 0 ]; then echo "RESULT: PASS ✅"; exit 0
else echo "RESULT: $fail 项不一致 ❌(修完再 commit)"; exit 1; fi
