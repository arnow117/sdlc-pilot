      "target": {"kind": "module", "id": "mod.delivery.static-check"},
      "resolution_group": "module-routing",
      "priority": 170,
      "when": {"op": "eq", "field": "evidence_strategy", "value": "static-check"}
    },
    {
      "id": "rule.module.delivery.contract-check",
      "kind": "selector",
      "target": {"kind": "module", "id": "mod.delivery.contract-check"},
      "resolution_group": "module-routing",
      "priority": 180,
      "when": {"op": "eq", "field": "evidence_strategy", "value": "contract-check"}
    },
    {
      "id": "rule.module.delivery.visual-regression",
      "kind": "selector",
      "target": {"kind": "module", "id": "mod.delivery.visual-regression"},
      "resolution_group": "module-routing",
      "priority": 190,
      "when": {"op": "eq", "field": "evidence_strategy", "value": "visual-regression"}
    },
    {
      "id": "rule.module.delivery.debugging",
      "kind": "selector",
      "target": {"kind": "module", "id": "mod.delivery.debugging"},
      "resolution_group": "module-routing",
      "priority": 200,
      "when": {
        "op": "in",
        "field": "issue_class",
        "values": ["regression", "runtime_error", "unexpected_failure"]
      }
    },
    {
      "id": "rule.module.delivery.validation-review",
      "kind": "selector",
      "target": {"kind": "module", "id": "mod.delivery.validation-review"},
