{
  "schema_version": "sdlc-policy-modules-v1",
  "policy": {
    "policy_format": "sdlc-policy-v1",
    "engine_api": {
      "min_inclusive": "1.0.0",
      "max_exclusive": "2.0.0"
    },
    "migration_version": "phase1-preview-v1",
    "activation": {
      "scope": "preview",
      "explicit_invocation_only": true,
      "control_mutations": false,
      "output_scope": "preview",
      "unknown_selector": "needs_classification",
      "legacy_projection": "legacy-route-projection-v1",
      "legacy_bridge": "legacy-composite-v1"
    }
  },
  "rules": [
    {
      "id": "rule.module.product.core",
      "kind": "selector",
      "target": {"kind": "module", "id": "mod.product.core"},
      "resolution_group": "module-routing",
      "priority": 10,
      "when": {"op": "always"}
    },
    {
      "id": "rule.module.product.behavior-contract",
      "kind": "selector",
      "target": {"kind": "module", "id": "mod.product.behavior-contract"},
      "resolution_group": "module-routing",
      "priority": 20,
      "when": {"op": "always"}
    },
    {
      "id": "rule.module.product.behavior-bdd",
      "kind": "selector",
      "target": {"kind": "module", "id": "mod.product.behavior-bdd"},
      "resolution_group": "module-routing",
      "priority": 30,
      "when": {
        "op": "any",
        "terms": [
          {"op": "present", "field": "behavior_ambiguity"},
          {"op": "present", "field": "business_rule_changed"},
          {"op": "present", "field": "new_behavior"}
        ]
      }
    },
    {
      "id": "rule.module.product.domain-ddd",
      "kind": "selector",
      "target": {"kind": "module", "id": "mod.product.domain-ddd"},
      "resolution_group": "module-routing",
      "priority": 40,
      "when": {"op": "present", "field": "domain_model_needed"}
    },
    {
      "id": "rule.module.product.experience-design",
      "kind": "selector",
      "target": {"kind": "module", "id": "mod.product.experience-design"},
      "resolution_group": "module-routing",
      "priority": 50,
      "when": {"op": "present", "field": "experience_change"}
    },
    {
      "id": "rule.module.product.product-eval",
