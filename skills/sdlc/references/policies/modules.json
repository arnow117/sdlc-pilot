      "id": "rule.module.delivery.architecture",
      "kind": "selector",
      "target": {"kind": "module", "id": "mod.delivery.architecture"},
      "resolution_group": "module-routing",
      "priority": 120,
      "when": {
        "op": "any",
        "terms": [
          {"op": "present", "field": "cross_surface"},
          {"op": "present", "field": "high_blast_radius"},
          {"op": "present", "field": "public_interface"}
        ]
      }
    },
    {
      "id": "rule.module.delivery.tactical-ddd",
