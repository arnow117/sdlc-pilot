#!/usr/bin/env sh
# sdlc-guard —— 并发/边界**硬门禁**(代码级、确定性)。
# 设计意图:不靠"模型记得检查"(那是软的、可被合理化绕过),而是由 git pre-commit hook
#          调用本脚本 → git 来跑、不是模型来跑 → 模型绕不过(唯一逃逸 = 人显式 `git commit --no-verify`)。
# 也被 sdlc driver 入口调用作可移植软层(Codex/无 hook 环境)。
# 退出码:0 = 边界一致,放行;1 = 边界违例,阻断。
#
# 检测(确定性,只读 git + 本地上下文):
#   ① `.sdlc/STATE.md`(feature) 与 `.sdlc/TASK.md`(task) 必须二选一。
#   ② STATE.branch/worktree 必须与当前 feature worktree 一致。
#   ③ TASK 的稳定身份字段必须齐全,task-branch/worktree 必须与当前 task worktree 精确一致。
#   ④ 无违例时输出当前 feature/task 身份,提醒提交者核对归属。

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
STATE="$repo_root/.sdlc/STATE.md"
TASK="$repo_root/.sdlc/TASK.md"
DUAL_LEDGER="$repo_root/.sdlc-control/dual-lifecycle/ledger.json"

if [ -f "$STATE" ] && [ -f "$TASK" ]; then
  echo "✗ sdlc-guard: .sdlc/STATE.md 与 .sdlc/TASK.md 同时存在。"
  echo "  feature worktree 只保留 STATE;task worktree 只保留 TASK。"
  exit 1
fi

[ -f "$STATE" ] || [ -f "$TASK" ] || exit 0

cur_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
cur_root=$(git rev-parse --show-toplevel 2>/dev/null)

field(){
  file=$1
  shift
  for key in "$@"; do
    value=$(grep -iE "^${key}:" "$file" 2>/dev/null | head -1 | sed 's/^[^:]*: *//' | tr -d '\r' | sed 's/^ *//;s/ *$//')
    if [ -n "$value" ]; then
      printf '%s' "$value"
      return 0
    fi
  done
  return 1
}

is_full_sha(){
  candidate=$1
  [ "${#candidate}" -eq 40 ] || return 1
  case "$candidate" in
    *[!0-9a-fA-F]*) return 1 ;;
  esac
  return 0
}

is_full_sha256(){
  candidate=$1
  [ "${#candidate}" -eq 64 ] || return 1
  case "$candidate" in
    *[!0-9a-fA-F]*) return 1 ;;
  esac
  return 0
}

check_contract_model(){
  context_file=$1
  context_name=$2
  model=$(field "$context_file" contract-model)
  ledger_sha=$(field "$context_file" dual-ledger-sha)

  # Both fields are optional for historical contexts.  Once either is present,
  # require an explicit, internally consistent authority selection.
  if [ -z "$model" ] && [ -z "$ledger_sha" ]; then
    return 0
  fi
  if [ -z "$model" ] || [ -z "$ledger_sha" ]; then
    echo "✗ sdlc-guard: $context_name 的 contract-model 与 dual-ledger-sha 必须同时提供。"
    viol=1
    return 1
  fi
  case "$model" in
    dual-lifecycle-v1)
      if ! is_full_sha256 "$ledger_sha"; then
        echo "✗ sdlc-guard: $context_name 的 dual-ledger-sha 必须是完整 64 位 SHA-256。"
        viol=1
      fi
      if [ ! -f "$DUAL_LEDGER" ]; then
        echo "✗ sdlc-guard: $context_name 声明 dual-lifecycle-v1，但缺少 $DUAL_LEDGER。"
        viol=1
      fi
      ;;
    legacy)
      echo "✗ sdlc-guard: $context_name 使用 legacy contract-model 时不得同时声明 dual-ledger-sha。"
      viol=1
      ;;
    *)
      echo "✗ sdlc-guard: $context_name 的 contract-model 必须是 dual-lifecycle-v1；未声明时按既有 legacy 协议处理。"
      viol=1
      ;;
  esac
}

viol=0

if [ -f "$TASK" ]; then
  required="execution-mode feature-id task-id feature-branch task-branch worktree branch-base-sha plan-revision control-head control-ref control-base-sha owner"
  for key in $required; do
    value=$(field "$TASK" "$key")
    if [ -z "$value" ]; then
      echo "✗ sdlc-guard: TASK 缺少身份字段 '$key'。"
      viol=1
    fi
  done

  task_mode=$(field "$TASK" execution-mode)
  task_branch=$(field "$TASK" task-branch)
  task_worktree=$(field "$TASK" worktree)
  feature_id=$(field "$TASK" feature-id)
  task_id=$(field "$TASK" task-id)
  branch_base=$(field "$TASK" branch-base-sha)
  plan_revision=$(field "$TASK" plan-revision)
  control_head=$(field "$TASK" control-head)
  control_base=$(field "$TASK" control-base-sha)

  check_contract_model "$TASK" "TASK"

  case "$task_mode" in
    shared-control|local-serial) ;;
    *)
      echo "✗ sdlc-guard: TASK execution-mode 必须是 shared-control 或 local-serial,当前为 '${task_mode:-缺失}'。"
      viol=1 ;;
  esac
  for pair in "branch-base-sha:$branch_base" "plan-revision:$plan_revision" "control-head:$control_head" "control-base-sha:$control_base"; do
    sha_name=${pair%%:*}
    sha_value=${pair#*:}
    if [ -n "$sha_value" ] && ! is_full_sha "$sha_value"; then
      echo "✗ sdlc-guard: TASK 的 $sha_name 必须是完整 40 位 commit id。"
      viol=1
    fi
  done
  case "$task_branch" in
    main|master|sdlc-control|refs/*|"")
      echo "✗ sdlc-guard: TASK task-branch '${task_branch:-缺失}' 不是可用的任务分支名。"
      viol=1 ;;
  esac
  if [ -n "$task_branch" ] && [ "$task_branch" != "$cur_branch" ]; then
    echo "✗ sdlc-guard: TASK 属于分支 '$task_branch',当前是 '$cur_branch'。"
    viol=1
  fi
  if [ -n "$task_worktree" ] && [ "$task_worktree" != "$cur_root" ]; then
    echo "✗ sdlc-guard: TASK 属于 worktree '$task_worktree',当前是 '$cur_root'。"
    viol=1
  fi

  if [ "$viol" -eq 0 ]; then
    echo "✓ sdlc-guard: task '${task_id:-?}' of feature '${feature_id:-?}' @ '$cur_branch' 身份一致。"
  fi
  exit "$viol"
fi

st_branch=$(field "$STATE" branch | tr -d '[:space:]')
st_worktree=$(field "$STATE" worktree | tr -d '[:space:]')
st_stage=$(field "$STATE" stage | tr -d '[:space:]')
st_status=$(field "$STATE" status | tr -d '[:space:]')
st_feature=$(grep -iE '^# SDLC State:' "$STATE" 2>/dev/null | head -1 | sed 's/^# SDLC State: *//')

check_contract_model "$STATE" "STATE"

if [ -n "$st_branch" ] && [ "$st_branch" != "$cur_branch" ]; then
  echo "✗ sdlc-guard: 当前 STATE 属于分支 '$st_branch',你现在在 '$cur_branch'。"
  echo "  切回 '$st_branch',或为新工作创建独立 worktree / 分支。"
  viol=1
fi
if [ -n "$st_worktree" ] && [ "$st_worktree" != "$cur_root" ]; then
  echo "✗ sdlc-guard: 当前 STATE 属于 worktree '$st_worktree',你现在在 '$cur_root'。"
  echo "  回到该 worktree,或让当前 worktree 使用自己的本地上下文。"
  viol=1
fi

if [ "$viol" -eq 0 ]; then
  echo "✓ sdlc-guard: feature '${st_feature:-?}'(stage=${st_stage:-?}, status=${st_status:-?}) @ '$cur_branch' 身份一致。"
  echo "  ⚠ 若本次提交不属于这个 feature,请先创建独立 worktree / 分支。"
fi
exit $viol
